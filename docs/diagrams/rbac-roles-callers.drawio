<mxfile host="Electron">
  <diagram id="rbac-roles-callers" name="RBAC-Roles-Callers">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b&gt;ROLES → PERMISSIONS&lt;/b&gt;" style="text;html=1;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="300" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;SAME REQUEST, FIVE CALLERS&lt;/b&gt;" style="text;html=1;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="400" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="ad" value="&lt;b&gt;ADMIN&lt;/b&gt; = manager +&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot;&gt;expense:read:all · update:all&lt;br&gt;delete:all · approve:all&lt;br&gt;export:all · role:assign&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="20" y="45" width="300" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="mg" value="&lt;b&gt;MANAGER&lt;/b&gt; = user +&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot;&gt;expense:read:team&lt;br&gt;approve:team · export:team&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="20" y="185" width="300" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="us" value="&lt;b&gt;USER&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:9px&quot;&gt;expense:create · read:own&lt;br&gt;update:own · delete:own&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="20" y="315" width="300" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="i1" value="inherits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=9;labelBackgroundColor=#ffffff" edge="1" source="us" target="mg" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i2" value="inherits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=9;labelBackgroundColor=#ffffff" edge="1" source="mg" target="ad" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="rq" value="&lt;font face=&quot;Courier New&quot;&gt;&lt;b&gt;GET /expenses/123&lt;/b&gt;&lt;/font&gt;&lt;br&gt;owner: Bob&lt;br&gt;Bob's manager: Maria" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="400" y="185" width="170" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="c1" value="&lt;b&gt;Bob&lt;/b&gt; · user, owner → &lt;b&gt;200&lt;/b&gt; user view" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="650" y="45" width="350" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;Alice&lt;/b&gt; · user, not owner → &lt;b&gt;404&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="650" y="115" width="350" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Maria&lt;/b&gt; · Bob's manager → &lt;b&gt;200&lt;/b&gt; + owner_name, cost_center" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="650" y="185" width="350" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Mark&lt;/b&gt; · another team's manager → &lt;b&gt;404&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="650" y="255" width="350" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Ada&lt;/b&gt; · admin → &lt;b&gt;200&lt;/b&gt; + fraud_score, account_last4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="650" y="325" width="350" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" source="rq" target="c1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" source="rq" target="c2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" source="rq" target="c3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" source="rq" target="c4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ce5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" source="rq" target="c5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="sod" value="&lt;b&gt;Separation of duties:&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;POST /expenses/123/approve&lt;/font&gt; by Bob → &lt;b&gt;403&lt;/b&gt;, even if Bob were admin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="400" y="400" width="600" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="take" value="&lt;b&gt;Same endpoint, three dimensions:&lt;/b&gt; which operations (function), which rows (own / team / all),&lt;br&gt;and which fields (role-specific view) — all driven by one role → permission map." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="190" y="470" width="640" height="55" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
