<mxfile host="Electron">
  <diagram id="decision-tree" name="Auth-Scheme-Decision">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s" value="New API client&lt;br&gt;who is calling?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="Human user?&lt;br&gt;(browser / mobile)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="260" y="270" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="Server-rendered app?&lt;br&gt;(cookies feel natural)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="470" y="60" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n_sess" value="&lt;b&gt;SESSION AUTH&lt;/b&gt;&lt;br&gt;SameSite=Strict cookie&lt;br&gt;+ CSRF token&lt;br&gt;+ rotate ID at login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="680" y="60" width="200" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="n_oauth" value="&lt;b&gt;OAUTH 2.0 + OIDC&lt;/b&gt;&lt;br&gt;auth code + PKCE&lt;br&gt;— or BFF pattern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="680" y="160" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="Same trust boundary?&lt;br&gt;(VPC / service mesh)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="470" y="270" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n_basic" value="&lt;b&gt;BASIC AUTH / mTLS&lt;/b&gt;&lt;br&gt;internal service-to-service&lt;br&gt;TLS non-negotiable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="680" y="270" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d4" value="Need instant&lt;br&gt;revocation?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="470" y="470" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="n_tok" value="&lt;b&gt;OPAQUE TOKEN&lt;/b&gt;&lt;br&gt;server-side lookup&lt;br&gt;revocable instantly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="680" y="445" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n_jwt" value="&lt;b&gt;JWT BEARER&lt;/b&gt;&lt;br&gt;RS256 · ≤15 min TTL&lt;br&gt;JWKS-verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="680" y="540" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="warn" value="&lt;b&gt;NEVER&lt;/b&gt;&lt;br&gt;static credentials on the public internet without TLS — at minimum: key + TLS + expiry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="920" y="290" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5" edge="1" source="s" target="d1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11" edge="1" source="d1" target="d2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11" edge="1" source="d2" target="n_sess" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-40" y="-15" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="no — SPA / mobile / 3rd-party" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11" edge="1" source="d2" target="n_oauth" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="40" y="15" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="no — machine to machine" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11" edge="1" source="d1" target="d3" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-15" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11" edge="1" source="d3" target="n_basic" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="no — crosses boundary" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11" edge="1" source="d3" target="d4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11" edge="1" source="d4" target="n_tok" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="no — exp suffices" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=11" edge="1" source="d4" target="n_jwt" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
