<mxfile host="Electron">
  <diagram id="passkey-ceremony" name="Passkey-Ceremonies">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="reg" value="&lt;b&gt;REGISTRATION — store a public key&lt;/b&gt;" style="text;html=1;fontSize=12;align=left" vertex="1" parent="1">
          <mxGeometry x="20" y="8" width="520" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="auth" value="&lt;b&gt;AUTHENTICATION — sign an origin-bound challenge&lt;/b&gt;" style="text;html=1;fontSize=12;align=left" vertex="1" parent="1">
          <mxGeometry x="580" y="8" width="500" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="r1" value="&lt;b&gt;Server&lt;/b&gt;&lt;br&gt;issues creation options:&lt;br&gt;challenge, rp.id, user.id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;Authenticator&lt;/b&gt;&lt;br&gt;generates key pair&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;pub (out) / priv (stays)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="330" y="50" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;Server stores&lt;/b&gt;&lt;br&gt;publicKey, credentialId,&lt;br&gt;signCount — no secret" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="190" y="160" width="190" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="re1" value="options" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff" edge="1" source="r1" target="r2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re2" value="attestation + public key" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff" edge="1" source="r2" target="r3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a1" value="&lt;b&gt;Server&lt;/b&gt;&lt;br&gt;issues request options:&lt;br&gt;challenge + rp.id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="600" y="50" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;Authenticator&lt;/b&gt;&lt;br&gt;local verify (biometric/PIN)&lt;br&gt;signs challenge + origin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="880" y="50" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;Server verifies&lt;/b&gt;&lt;br&gt;signature, origin, rp.id,&lt;br&gt;challenge, signCount ↑" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="740" y="160" width="190" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="ae1" value="challenge" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff" edge="1" source="a1" target="a2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae2" value="signed assertion" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff" edge="1" source="a2" target="a3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="phish" value="&lt;b&gt;Why phishing dies&lt;/b&gt;&lt;br&gt;&lt;br&gt;attacker's proxy site = wrong origin&lt;br&gt;signature is bound to &lt;font face=&quot;Courier New&quot;&gt;rp.id&lt;/font&gt;&lt;br&gt;→ relayed assertion fails verification&lt;br&gt;&lt;br&gt;&lt;i&gt;TOTP: forwarded digits still work — passkeys don't&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="80" y="270" width="400" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="concepts" value="&lt;b&gt;Key concepts&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;discoverable&lt;/b&gt; — key stores user handle → usernameless&lt;br&gt;&lt;b&gt;synced&lt;/b&gt; — roams via iCloud/Google keychain&lt;br&gt;&lt;b&gt;device-bound&lt;/b&gt; — YubiKey-style, higher assurance&lt;br&gt;&lt;b&gt;signCount&lt;/b&gt; — clone detector; regression = copied key&lt;br&gt;&lt;b&gt;uv vs up&lt;/b&gt; — biometric/PIN vs. mere tap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;verticalAlign=top;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="560" y="270" width="460" height="160" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
