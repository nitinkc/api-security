  <diagram id="bola-bfla-bopla" name="BOLA-BFLA-BOPLA">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="h1" value="&lt;b&gt;BOLA&lt;/b&gt; — API1&lt;br&gt;object level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="&lt;b&gt;BFLA&lt;/b&gt; — API5&lt;br&gt;function level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="300" height="50" as="geometry"/>
