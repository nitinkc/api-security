        <mxCell id="m2" value="✗ never asked: &lt;b&gt;may a member delete users?&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontSize=10;fontColor=#b85450" vertex="1" parent="1">
