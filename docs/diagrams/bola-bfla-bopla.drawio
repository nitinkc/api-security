        <mxCell id="h3" value="&lt;b&gt;BOPLA&lt;/b&gt; — API3&lt;br&gt;property level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="680" y="20" width="300" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="r1" value="GET /invoices/1002&lt;br&gt;Authorization: Bearer &amp;lt;alice&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="20" y="100" width="300" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="DELETE /users/77&lt;br&gt;Authorization: Bearer &amp;lt;member&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="350" y="100" width="300" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="PATCH /users/me&lt;br&gt;{&amp;quot;name&amp;quot;:&amp;quot;Alice&amp;quot;,&amp;quot;role&amp;quot;:&amp;quot;admin&amp;quot;}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;fontFamily=Courier New" vertex="1" parent="1">
          <mxGeometry x="680" y="100" width="300" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="a1" value="✓ token valid — &amp;quot;alice is logged in&amp;quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="20" y="185" width="300" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="✓ token valid — UI hides the delete button" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="350" y="185" width="300" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="✓ token valid — body bound onto User entity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="680" y="185" width="300" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="m1" value="✗ never asked: &lt;b&gt;is invoice 1002 alice's?&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontSize=10;fontColor=#b85450" vertex="1" parent="1">
          <mxGeometry x="20" y="255" width="300" height="40" as="geometry"/>
