          <mxGeometry x="680" y="325" width="300" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="x1" value="&lt;b&gt;Fix:&lt;/b&gt; scope the query by caller&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;WHERE id = :id AND owner_id = :me&lt;/font&gt;&lt;br&gt;→ 404" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="20" y="400" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="x2" value="&lt;b&gt;Fix:&lt;/b&gt; permission check on every route,&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;users:delete&lt;/font&gt;, deny-by-default router&lt;br&gt;→ 403" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="350" y="400" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="x3" value="&lt;b&gt;Fix:&lt;/b&gt; explicit input / output DTOs,&lt;br&gt;unknown fields rejected&lt;br&gt;→ 422 / field ignored" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="680" y="400" width="300" height="70" as="geometry"/>
