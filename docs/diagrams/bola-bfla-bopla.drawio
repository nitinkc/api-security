          <mxGeometry x="680" y="255" width="300" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="o1" value="&lt;b&gt;200&lt;/b&gt; — Bob's invoice leaked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="20" y="325" width="300" height="40" as="geometry"/>
