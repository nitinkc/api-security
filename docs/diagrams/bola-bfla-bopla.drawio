        <mxCell id="o2" value="&lt;b&gt;204&lt;/b&gt; — another user deleted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="350" y="325" width="300" height="40" as="geometry"/>
