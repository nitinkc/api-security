        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;① Verify the token&lt;/b&gt;&lt;br&gt;signature · iss · exp · &lt;b&gt;aud&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="560" y="50" width="260" height="55" as="geometry"/>
