        <mxCell id="n2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;strokeWidth=1.5" edge="1" source="s2" target="f2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
