<mxfile host="Electron">
  <diagram id="scope-vs-object" name="Scope-vs-Object">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="440" math="0" shadow="0">
