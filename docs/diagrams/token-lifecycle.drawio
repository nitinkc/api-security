<mxfile host="Electron">
  <diagram id="token-lifecycle" name="Token-Lifecycle">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="ph1" value="&lt;b&gt;ISSUE&lt;/b&gt;" style="text;html=1;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="15" width="300" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="ph2" value="&lt;b&gt;USE — every request&lt;/b&gt;" style="text;html=1;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="300" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="ll_client" value="&lt;b&gt;Client&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="60" y="45" width="160" height="460" as="geometry"/>
        </mxCell>
        <mxCell id="ll_api" value="&lt;b&gt;API Server&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="400" y="45" width="160" height="460" as="geometry"/>
        </mxCell>
        <mxCell id="ll_store" value="&lt;b&gt;Token Store&lt;/b&gt;&lt;br&gt;(hash-indexed)" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="730" y="45" width="170" height="460" as="geometry"/>
        </mxCell>

        <mxCell id="m1" value="① POST /token&lt;br&gt;{ credentials / api-key / grant }" style="html=1;endArrow=block;endSize=10;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=10" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="110" as="sourcePoint"/>
            <mxPoint x="480" y="110" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="② persist&lt;br&gt;hash(token) → {client, scopes, expiry}" style="html=1;endArrow=block;endSize=10;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=10" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="170" as="sourcePoint"/>
            <mxPoint x="815" y="170" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="③ { &amp;quot;token&amp;quot;: &amp;quot;sk_live_…&amp;quot; }&lt;br&gt;returned ONCE — never stored plaintext" style="html=1;endArrow=block;endSize=10;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=10;dashed=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="230" as="sourcePoint"/>
            <mxPoint x="140" y="230" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="④ GET /resource&lt;br&gt;Authorization: Bearer sk_live_…" style="html=1;endArrow=block;endSize=10;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=10" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="330" as="sourcePoint"/>
            <mxPoint x="480" y="330" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="⑤ lookup hash(token)" style="html=1;endArrow=block;endSize=10;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=10" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="480" y="385" as="sourcePoint"/>
            <mxPoint x="815" y="385" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="⑥ { owner, scopes, expires }&lt;br&gt;→ 200 or 401" style="html=1;endArrow=block;endSize=10;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontSize=10;dashed=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="815" y="440" as="sourcePoint"/>
            <mxPoint x="480" y="440" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="note_end" value="&lt;b&gt;END&lt;/b&gt; — expiry auto-invalidates the row;&lt;br&gt;revocation = delete the row (instant, every server)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="600" y="490" width="330" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="note_opaque" value="&lt;b&gt;opaque&lt;/b&gt; = no crypto inside the token —&lt;br&gt;the string proves possession, the store proves meaning" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="20" y="490" width="330" height="60" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
