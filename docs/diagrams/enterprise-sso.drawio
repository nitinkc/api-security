<mxfile host="Electron">
  <diagram id="enterprise-sso" name="Enterprise-SSO">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="saml" value="&lt;b&gt;SAML 2.0 — everything through the browser&lt;/b&gt;" style="text;html=1;fontSize=12;align=left" vertex="1" parent="1">
          <mxGeometry x="20" y="8" width="500" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="oidc" value="&lt;b&gt;OIDC — code redeemed on the back channel&lt;/b&gt;" style="text;html=1;fontSize=12;align=left" vertex="1" parent="1">
          <mxGeometry x="580" y="8" width="500" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="u1" value="&lt;b&gt;Browser&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="45" width="90" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="sp" value="&lt;b&gt;SP&lt;/b&gt;&lt;br&gt;your app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="210" y="45" width="110" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="idp1" value="&lt;b&gt;IdP&lt;/b&gt;&lt;br&gt;Entra / Okta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="420" y="45" width="110" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="u2" value="&lt;b&gt;Browser&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="590" y="45" width="90" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="&lt;b&gt;Client app&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="760" y="45" width="110" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="idp2" value="&lt;b&gt;IdP&lt;/b&gt;&lt;br&gt;authorization server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="960" y="45" width="110" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="1 GET /app → AuthnRequest (redirect)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff" edge="1" source="u1" target="idp1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="85" y="120"/><mxPoint x="475" y="120"/></Array></mxGeometry></mxCell>
        <mxCell id="a2" value="2 user authenticates (+MFA)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;fontSize=10;labelBackgroundColor=#ffffff;dashed=1" edge="1" source="idp1" target="idp1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="65"/><mxPoint x="560" y="160"/><mxPoint x="475" y="160"/></Array></mxGeometry></mxCell>
        <mxCell id="a3" value="3 POST signed XML assertion → ACS" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff" edge="1" source="idp1" target="u1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="475" y="200"/><mxPoint x="85" y="200"/></Array></mxGeometry></mxCell>
        <mxCell id="a4" value="4 browser POSTs assertion to ACS URL" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff" edge="1" source="u1" target="sp" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="85" y="240"/><mxPoint x="265" y="240"/></Array></mxGeometry></mxCell>
        <mxCell id="a5" value="5 SP verifies signature → session" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;fontSize=10;labelBackgroundColor=#ffffff;dashed=1" edge="1" source="sp" target="sp" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="65"/><mxPoint x="350" y="270"/><mxPoint x="265" y="270"/></Array></mxGeometry></mxCell>
        <mxCell id="b1" value="1 redirect to /authorize" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff" edge="1" source="u2" target="idp2" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="635" y="120"/><mxPoint x="1015" y="120"/></Array></mxGeometry></mxCell>
        <mxCell id="b2" value="2 user authenticates (+MFA)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;fontSize=10;labelBackgroundColor=#ffffff;dashed=1" edge="1" source="idp2" target="idp2" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="65"/><mxPoint x="1080" y="160"/><mxPoint x="1015" y="160"/></Array></mxGeometry></mxCell>
        <mxCell id="b3" value="3 redirect back with code" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff" edge="1" source="idp2" target="u2" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1015" y="200"/><mxPoint x="635" y="200"/></Array></mxGeometry></mxCell>
        <mxCell id="b4" value="4 app redeems code → tokens (back channel)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff" edge="1" source="app" target="idp2" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="815" y="250"/><mxPoint x="1015" y="250"/></Array></mxGeometry></mxCell>
        <mxCell id="b5" value="code delivered via browser" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;fontSize=10;labelBackgroundColor=#ffffff" edge="1" source="u2" target="app" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="635" y="230"/><mxPoint x="815" y="230"/></Array></mxGeometry></mxCell>
        <mxCell id="ldap" value="&lt;b&gt;LDAP / AD / Kerberos&lt;/b&gt;&lt;br&gt;&lt;br&gt;• directory the IdP queries for users &amp; groups&lt;br&gt;• LDAP bind = app re-checks password (LDAPS only!)&lt;br&gt;• Kerberos = ticket-based Windows internal SSO&lt;br&gt;• backends &lt;i&gt;behind&lt;/i&gt; the IdP — not an API concern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="440" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="pit" value="&lt;b&gt;Federation pitfalls&lt;/b&gt;&lt;br&gt;&lt;br&gt;• trust IdP groups → map to roles via allowlist&lt;br&gt;• validate &lt;font face=&quot;Courier New&quot;&gt;iss&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;aud&lt;/font&gt;, signature every time&lt;br&gt;• exact-match ACS / redirect URLs&lt;br&gt;• offboarding: disable → access dies within token TTL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="580" y="320" width="440" height="130" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
