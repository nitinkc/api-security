<mxfile host="Electron">
  <diagram id="tenant-isolation" name="Tenant-Isolation">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b&gt;ISOLATION LAYERS — defense in depth&lt;/b&gt;" style="text;html=1;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="380" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;WHERE TENANT &amp;amp; ACTOR COME FROM&lt;/b&gt;" style="text;html=1;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="460" y="10" width="400" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="l1" value="&lt;b&gt;Verified token&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;sub&lt;/font&gt; + &lt;font face=&quot;Courier New&quot;&gt;tenant_id&lt;/font&gt; — the only source of truth" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="20" y="45" width="370" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="l2" value="&lt;b&gt;Gateway&lt;/b&gt;&lt;br&gt;tenant claim present and valid" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="20" y="130" width="370" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="l3" value="&lt;b&gt;Service&lt;/b&gt;&lt;br&gt;every query &lt;font face=&quot;Courier New&quot;&gt;WHERE tenant_id = :tenant&lt;/font&gt;; tenant in cache keys" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="20" y="215" width="370" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="l4" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;row-level security on &lt;font face=&quot;Courier New&quot;&gt;app.tenant_id&lt;/font&gt; (transaction-local)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="370" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="l5" value="&lt;b&gt;Optional&lt;/b&gt;&lt;br&gt;schema / DB per tenant · per-tenant KMS keys" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;dashed=1" vertex="1" parent="1">
          <mxGeometry x="20" y="385" width="370" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="le1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5" edge="1" source="l1" target="l2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5" edge="1" source="l2" target="l3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1.5" edge="1" source="l3" target="l4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1" edge="1" source="l4" target="l5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="bad" value="Client sends&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;X-Tenant-ID: globex&lt;/font&gt;&lt;br&gt;(token says acme)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="460" y="45" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="badr" value="&lt;b&gt;ignored or 403&lt;/b&gt;&lt;br&gt;client-supplied tenant&lt;br&gt;is attacker-controlled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="690" y="45" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="be" value="mismatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;fontSize=9;labelBackgroundColor=#ffffff" edge="1" source="bad" target="badr" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="dt" value="{&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;sub&amp;quot;: &amp;quot;user-123&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;act&amp;quot;: {&amp;quot;sub&amp;quot;: &amp;quot;support-agent-9&amp;quot;},&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;tenant_id&amp;quot;: &amp;quot;acme&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;scope&amp;quot;: &amp;quot;tickets:read&amp;quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;quot;exp&amp;quot;: now + 15 min&lt;br&gt;}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontFamily=Courier New;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="460" y="170" width="410" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="dtl" value="&lt;b&gt;Delegated token&lt;/b&gt; (impersonation / token exchange)" style="text;html=1;fontSize=10;align=left" vertex="1" parent="1">
          <mxGeometry x="460" y="143" width="410" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="dd" value="&lt;b&gt;decision&lt;/b&gt; = what &lt;font face=&quot;Courier New&quot;&gt;sub&lt;/font&gt; may do ∩ what &lt;font face=&quot;Courier New&quot;&gt;act&lt;/font&gt; may do while delegating" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="460" y="320" width="410" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="da" value="&lt;b&gt;audit log&lt;/b&gt; records both identities · scoped · time-boxed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="460" y="395" width="410" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="de1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block" edge="1" source="dt" target="dd" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block" edge="1" source="dd" target="da" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="take" value="&lt;b&gt;One missed WHERE clause is a cross-tenant breach.&lt;/b&gt; Take the tenant from the token,&lt;br&gt;filter in the service, and let row-level security catch the query that forgot." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="120" y="470" width="640" height="55" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
